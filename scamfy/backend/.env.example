# ==============================================================================
# Scamfy Backend Environment Template (backend/.env.example)
# Note: Private server-side secrets ONLY. Never expose to client bundles.
# ==============================================================================

# Application Settings
PROJECT_NAME="Scamfy API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# NVIDIA Nemotron Inference (NIM API - Server-side only)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL_SLUG=nvidia/llama-3.1-nemotron-70b-instruct

# Clerk Authentication (Server-Side Secret Key)
CLERK_SECRET_KEY=

# Internal Service Communication Secret
INTERNAL_API_SECRET=

# Cloudflare R2 / S3 Object Storage (Private Evidence Vault)
R2_BUCKET_NAME=scamfy-evidence
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
