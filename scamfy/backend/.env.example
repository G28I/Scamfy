# ==========================================
# Scamfy Backend Environment Template (backend/.env.example)
# Note: Private server-side secrets ONLY. Never expose to client bundles.
# ==========================================

# Application Settings
PROJECT_NAME="Scamfy API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# NVIDIA Nemotron Inference (NIM API)
NVIDIA_API_KEY=nvapi-placeholder_server_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL_SLUG=nvidia/llama-3.1-nemotron-70b-instruct

# Clerk Authentication (Server Secret)
CLERK_SECRET_KEY=sk_test_placeholder_for_clerk_secret

# PostgreSQL Database (Configured in Phase 3)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scamfy

# Cloudflare R2 / S3 Object Storage (Private Evidence Vault)
R2_BUCKET_NAME=scamfy-evidence
R2_ACCESS_KEY_ID=r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=r2_secret_key_placeholder
