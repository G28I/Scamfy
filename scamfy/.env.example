# ==============================================================================
# Scamfy Frontend Environment Template (.env.example)
# Note: Public client variables MUST use NEXT_PUBLIC_* prefix.
# Private secrets MUST remain strictly server-side (never prefixed with NEXT_PUBLIC_).
# ==============================================================================

# Clerk Authentication (Public Key - Safe for browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Route Redirection Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook Secret (for Svix signature verification on user sync)
CLERK_WEBHOOK_SIGNING_SECRET=

# FastAPI Backend URL (BFF / Service Proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Server-Side Internal Service Secret (Never expose to client)
INTERNAL_API_SECRET=

# Server-Side Authentication Secret (HMAC-SHA256 Session Signing - Minimum 32 characters in production)
# Dedicated session signing secret only (never use CLERK_SECRET_KEY or INTERNAL_API_SECRET)
AUTH_SECRET=
SESSION_SECRET=

# PostgreSQL Database Connection (Prisma ORM - Server-side only)
DATABASE_URL="postgresql://user:password@localhost:5432/scamfy?schema=public"
